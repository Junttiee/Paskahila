#!/bin/bash -l

#SBATCH --job-name=CollideRight
#SBATCH --account=lappi
#SBATCH --partition=small

#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=40

module add fftw/3.3.10-mpi-omp gsl

OMP_NUM_THREADS=40 ./RightSUNcSolver.exe -Nx 128 -Ny 128 -Nz 1024 -ax 1.0 -ay 1.0 -az 0.25 -SEED 1 -o RightTest
